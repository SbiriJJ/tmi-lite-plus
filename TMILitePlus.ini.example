; TMI Lite+ 2.1 public preference defaults.
; Codex installation and shared permissions are managed by TMIHost.
; Local session details and EULA acceptance are written after use.

[UI]
IdleRateLimitPolling=1

[Conversation]
RollingLineLimit=1000
ResumeTurnLimit=30
CacheEnabled=1

[Activity]
RollingRowLimit=200

[ConversationColors]
User=$003A2B24
Agent=$00372831
Final=$002B3523
Report=$002A3038
Error=$002A233E

[Updates]
Channel=release
ReleaseFrequency=daily
RollingFrequency=startup
